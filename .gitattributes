# Normalize everything to LF in the repo; check out native on Windows.
# Matches unitrack-backend and unitrack-helper. Without this, a teammate whose
# git lacks `core.autocrlf=input` commits CRLF, and the Linux containers that
# build these apps treat a CRLF shell script or entrypoint as "not found".
* text=auto eol=lf

# Scripts whose line endings are load-bearing.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary

# Generated: keep them out of diffs so a review shows intent, not churn.
pnpm-lock.yaml -diff
packages/api-client/src/schema.d.ts -diff
