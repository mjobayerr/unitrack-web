# Runtime config for the built SPA. The nginx image envsubst's ${PORT} (and only
# real environment variables) into this at start, so nginx's own $uri/$host/
# $http_upgrade are left untouched. Mirrors each app's vite.config.ts dev proxy
# so dev and prod resolve /api and /ws identically.
server {
    listen       ${PORT};
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # Fingerprinted bundles can be cached hard; index.html must not be, or a
    # deploy leaves browsers pinned to the previous build.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # /api/* -> API with the /api prefix stripped (the trailing slash on
    # proxy_pass does the strip): /api/auth/login -> http://api:8000/auth/login.
    location /api/ {
        proxy_pass         http://api:8000/;
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # /ws/* -> API unchanged, upgraded to a WebSocket (live tracking).
    location /ws/ {
        proxy_pass         http://api:8000/ws/;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host $host;
        proxy_read_timeout 3600s;
    }

    # Client-side routing: an unknown path returns the app shell, not a 404.
    location / {
        try_files $uri /index.html;
    }
}
