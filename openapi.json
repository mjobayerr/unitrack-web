},"AlertStatus":{"type":"string","enum":["open","acknowledged","resolved","dismissed"],"title":"AlertStatus"},"AlertType":{"type":"string","enum":["sos","breakdown","traffic_delay","accident","harassment","overcrowding","off_route","over_speed","gps_blackout","other"],"title":"AlertType"},"BusCreate":{"properties":{"reg_no":{"type":"string","title":"Reg No"},"nickname":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Nickname"},"capacity":{"type":"integer","title":"Capacity","default":40},"status":{"$ref":"#/components/schemas/BusStatus","default":"active"}},"type":"object","required":["reg_no"],"title":"BusCreate"},"BusListCreate":{"properties":{"buses":{"items":{"$ref":"#/components/schemas/BusCreate"},"type":"array","title":"Buses"}},"type":"object","required":["buses"],"title":"BusListCreate"},"BusOut":{"properties":{"id":{"type":"string","format":"uuid","title":"Id"},"reg_no":{"type":"string","title":"Reg No"},"nickname":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Nickname"},"capacity":{"type":"integer","title":"Capacity"},"status":{"$ref":"#/components/schemas/BusStatus"}},"type":"object","required":["id","reg_no","nickname","capacity","status"],"title":"BusOut"},"BusStatus":{"type":"string","enum":["active","inactive","maintenance"],"title":"BusStatus"},"GpsAccepted":{"properties":{"accepted":{"type":"integer","title":"Accepted"},"bus_id":{"type":"string","format":"uuid","title":"Bus Id"},"trip_id":{"anyOf":[{"type":"string","format":"uuid"},{"type":"null"}],"title":"Trip Id"}},"type":"object","required":["accepted","bus_id"],"title":"GpsAccepted"},"GpsBatch":{"properties":{"bus_id":{"type":"string","format":"uuid","title":"Bus Id"},"points":{"items":{"$ref":"#/components/schemas/GpsPointIn"},"type":"array","maxItems":50,"minItems":1,"title":"Points"}},"type":"object","required":["bus_id","points"],"title":"GpsBatch","description":"A batch of buffered fixes from the helper device (spec §7.3: ~1-10 per ~5s)."},"GpsPointIn":{"properties":{"lat":{